# jiggle3 на NAS (на NAS создаётся .env; в git не попадает)
HOST_PORT=18001
HOME_HOST=192.168.6.115
SERVICE_DESCRIPTION=Организация медиатеки: импорт, дедупликация, коллекции
MEM_LIMIT=1g

# Хост-путь медиатеки на NAS. ВАЖНО: регистр имеет значение (/Volume1, не /volume1),
# и jiffle пишет сюда (импорт копирует файлы, откат удаляет) - поэтому маунт read-write.
MEDIA_HOST_PATH=/Volume1/NAS/pics